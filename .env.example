# Copy to .env and change what you need. Every value below is also the default.

# Clients send this in the X-API-Key header. Change it.
API_KEY=change-me
POSTGRES_PASSWORD=rag
# The API listens on 127.0.0.1:<API_PORT> on the host.
API_PORT=8000

# --- Models -----------------------------------------------------------------
# Chat model pulled into Ollama on first start (any tag from ollama.com/library).
# qwen3:4b-instruct needs about 5 GB of RAM. On smaller machines try qwen2.5:1.5b
# (faster, but it cites less reliably and makes more mistakes).
OLLAMA_MODEL=qwen3:4b-instruct
# Embedding and reranker models are baked into the image at build time:
# rebuild after changing them (docker compose up -d --build). A new embedding
# model with a different vector size also needs a fresh database (docker compose down -v).
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# --- Retrieval ----------------------------------------------------------------
# CHUNK_WORDS=200            # words per chunk
# CHUNK_OVERLAP_WORDS=40     # words repeated between neighbouring chunks
# TOP_K=5                    # results returned by /search
# CANDIDATES=30              # results taken from each retriever before fusion
# RERANK_CANDIDATES=20       # fused results the cross-encoder re-scores
# RRF_K=60                   # reciprocal rank fusion constant
# MAX_UPLOAD_MB=25           # per file, for /ingest
# LLM_MAX_TOKENS=400
# LLM_TIMEOUT_S=180

# --- GPU mode (NVIDIA GPU + NVIDIA Container Toolkit) -------------------------
# Uncomment both lines to serve the chat model with vLLM instead of Ollama.
# COMPOSE_PROFILES=gpu
# LLM_PROVIDER=vllm
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# HF_TOKEN=                  # only for gated models
